        function listReports(kmuj, section, sdate, edate) {
            $.ajax({
                url: linkDepan + "GetR1Plan?Kmuj=" + kmuj + "&Section=" + section + "&SDate=" + sdate + "&Edate=" + edate,
                type: 'GET',
                dataType: 'json',
                beforeSend: function (request) {
                    request.setRequestHeader("Token", localStorage.getItem('main'));
                },
                success: function (data) {
                    const targetTableIds = ['#tableRep', '#tableRepNormal', '#tableRepEng', '#tableRepCI'];

                    // 1. Destroy existing DataTables instances cleanly safely
                    targetTableIds.forEach(id => {
                        if ($.fn.dataTable.isDataTable(id)) {
                            $(id).DataTable().clear().destroy();
                        }
                        // Wipe structural contents individually
                        $(id).find('thead').empty();
                        $(id).find('tbody').empty();
                        $(id).find('tfoot').remove();
                    });

                    $('#tableMetadataViewTop').remove();

                    const startDate = moment(sdate, ['YYYY/MM/DD', 'YYYY-MM-DD']);
                    const endDate = moment(edate, ['YYYY/MM/DD', 'YYYY-MM-DD']);
                    const weekNumber = startDate.isValid() ? startDate.week() : "undefined";
                    const weekEndingStr = endDate.isValid() ? endDate.format('DD/MM/YYYY') : edate;

                    let weekNo = weekNumber;
                    let weekEndingDate = weekEndingStr;


                    // Format dynamic date display for the top title banner
                    const reportDateRange = startDate.isValid() && endDate.isValid()
                        ? `${startDate.format('DD/MM/YYYY')} TO ${endDate.format('DD/MM/YYYY')}`
                        : `${sdate} TO ${edate}`;

                    const uniquework_name = [...new Set(data.map(item => item.work_name))];

                    const updatedByPerson = (data && data.length > 0 && data[0].staff_name) ? data[0].staff_name : "undefined";

                    let headerRow1 = ['Staff No', 'Name', 'Designation'];
                    headerRow1.push('ATTENDANCE', '', '', '', '', '', '');
                    uniquework_name.forEach(desc => {
                        headerRow1.push(desc, '', '', '', '', '', '');
                    });

                    let headerRow2 = ['', '', ''];
                    for (let i = 0; i < (1 + uniquework_name.length); i++) {
                        for (let j = 0; j < 7; j++) {
                            headerRow2.push(moment(startDate).add(j, 'days').format('DD'));
                        }
                    }

                    // Generate structural components
                    let theadHtml = '<tr><th rowspan="2">Staff No</th><th rowspan="2">Name</th><th rowspan="2">Designation</th>';
                    theadHtml += `<th colspan="7">ATTENDANCE</th>`;
                    uniquework_name.forEach(desc => { theadHtml += `<th colspan="7">${desc}</th>`; });
                    theadHtml += '</tr><tr>';
                    for (let i = 0; i < (1 + uniquework_name.length); i++) {
                        for (let j = 0; j < 7; j++) {
                            theadHtml += `<th>${moment(startDate).add(j, 'days').format('DD')}</th>`;
                        }
                    }
                    theadHtml += '</tr>';

                    // Statistics initializers
                    let attStats = { valid: Array(7).fill(0), al: Array(7).fill(0), mc: Array(7).fill(0), ab: Array(7).fill(0), cs: Array(7).fill(0) };
                    let workStats = {};
                    uniquework_name.forEach(name => { workStats[name] = { dp: Array(7).fill(0), up: Array(7).fill(0) }; });
                    let dailyAdditionalMap = {};
                    const trackedDailyAttendance = {};

                    const groupedData = data.reduce((acc, item) => {
                        const dateKey = moment(item.daily_date).format('YYYY-MM-DD');
                        const empId = item.Emplid;
                        const trackingKey = `${empId}_${dateKey}`;
                        const dayIndex = moment(item.daily_date).diff(startDate, 'days');

                        if (item.daily_additional) {
                            dailyAdditionalMap[`${dateKey}_${item.work_name}`] = item.daily_additional;
                        }
                        if (!acc[empId]) {
                            acc[empId] = { Nama: item.Nama, JobDesc: item.JobDesc, work_data: {}, attendance_data: {} };
                        }

                        acc[empId].attendance_data[dateKey] = { leave: item.leaveType_id };

                        if (!acc[empId].work_data[item.work_name]) {
                            acc[empId].work_data[item.work_name] = {};
                        }

                        let rawCode = (item.work_plan_type_code === null) ? "pl" : String(item.work_plan_type_code).toLowerCase().trim();
                        if (rawCode === "") rawCode = "pl";
                        acc[empId].work_data[item.work_name][dateKey] = rawCode;

                        if (dayIndex >= 0 && dayIndex < 7) {
                            if (rawCode === "dp" || rawCode === "up") {
                                if (workStats[item.work_name]) workStats[item.work_name][rawCode][dayIndex]++;
                            }
                            if (!trackedDailyAttendance[trackingKey]) {
                                const l = item.leaveType_id ? String(item.leaveType_id).toLowerCase().trim() : "valid";

                                if (l === "al" || l === "ct") {
                                    attStats.al[dayIndex]++;
                                } else if (l === "mc" || l === "s") {
                                    attStats.mc[dayIndex]++;
                                } else if (l === "ab" || l === "th") {
                                    attStats.ab[dayIndex]++;
                                } else if (l === "cs" || l === "ce") {
                                    attStats.cs[dayIndex]++;
                                } else {
                                    attStats.valid[dayIndex]++;
                                }

                                trackedDailyAttendance[trackingKey] = true;
                            }
                        }
                        return acc;
                    }, {});

                    let tbodyHtml = '';
                    for (let staffNo in groupedData) {
                        tbodyHtml += `<tr><td>${staffNo}</td><td>${groupedData[staffNo].Nama}</td><td>${groupedData[staffNo].JobDesc}</td>`;

                        for (let i = 0; i < 7; i++) {
                            let d = moment(startDate).add(i, 'days').format('YYYY-MM-DD');
                            let dayInfo = groupedData[staffNo].attendance_data[d];
                            let displayValue = "";
                            let leaveTypeTracking = "valid";
                            let isClickable = false;

                            if (dayInfo && dayInfo.leave !== undefined && dayInfo.leave !== null && String(dayInfo.leave).trim() !== "") {
                                isClickable = true;
                                const leave = String(dayInfo.leave).toLowerCase().trim();

                                if (leave === "al" || leave === "ct") {
                                    displayValue = "CT";
                                    leaveTypeTracking = "al";
                                } else if (leave === "mc" || leave === "s") {
                                    displayValue = "S";
                                    leaveTypeTracking = "mc";
                                } else if (leave === "ab" || leave === "th") {
                                    displayValue = "TH";
                                    leaveTypeTracking = "ab";
                                } else if (leave === "cs" || leave === "ce") {
                                    displayValue = "CE";
                                    leaveTypeTracking = "cs";
                                } else if (leave === "ca") {
                                    displayValue = "CA";
                                    leaveTypeTracking = "valid";
                                } else if (leave !== "" && leave !== "valid") {
                                    displayValue = dayInfo.leave.toUpperCase();
                                    leaveTypeTracking = "valid";
                                }
                            }

                            let disabledAttr = isClickable ? "" : 'disabled="disabled"';
                            let cursorStyle = isClickable ? "cursor:pointer;" : "cursor:not-allowed; opacity: 0.65; pointer-events: none;";

                            tbodyHtml += `<td>
                        <a class="btn attendance-toggle" 
                           data-emplid="${staffNo}" 
                           data-date="${d}" 
                           data-leavetype="${leaveTypeTracking}"
                           ${disabledAttr}
                           style="display:block; ${cursorStyle}">
                           <span class="attendance-text">${displayValue}</span>
                        </a>
                    </td>`;
                        }

                        uniquework_name.forEach(wn => {
                            for (let i = 0; i < 7; i++) {
                                let d = moment(startDate).add(i, 'days').format('YYYY-MM-DD');
                                if (groupedData[staffNo].work_data[wn] && groupedData[staffNo].work_data[wn].hasOwnProperty(d)) {
                                    let currentCodeVal = groupedData[staffNo].work_data[wn][d];
                                    let iconClass = "fa-minus fa-rotate-90";
                                    if (currentCodeVal === "dp") iconClass = "fa-plus";
                                    else if (currentCodeVal === "up") iconClass = "fa-minus";
                                    tbodyHtml += `<td><a class="btn workplan-toggle" data-emplid="${staffNo}" data-date="${d}" data-workname="${wn}" data-code="${currentCodeVal}"><i class="fa ${iconClass}"></i></a></td>`;
                                } else {
                                    tbodyHtml += `<td></td>`;
                                }
                            }
                        });
                        tbodyHtml += `</tr>`;
                    }

                    const footerMapping = [
                        { label: 'TOTAL ATTENDANCE', attKey: 'valid', type: 'attendance' },
                        { label: 'TOTAL YEARLY LEAVE', attKey: 'al', type: 'leave' },
                        { label: 'TOTAL SICK LEAVE', attKey: 'mc', type: 'leave' },
                        { label: 'TOTAL ABSENT', attKey: 'ab', type: 'leave' },
                        { label: 'TOTAL CUTI EHSAN', attKey: 'cs', type: 'leave' }
                    ];

                  footerMapping.forEach(rowConfig => {
                        tbodyHtml += `<tr class="summary-row" style="font-weight:bold; background-color:#ffffff !important;">` +
                            `<td class="merged-style-left">${rowConfig.label}</td>` +
                            `<td class="merged-style-middle"></td>` +
                            `<td class="merged-style-right"></td>`;

                        // 1. Render the Attendance section cells (Columns 3 to 9)
                        attStats[rowConfig.attKey].forEach((val, i) => {
                            // --- CHANGED: Leave 'TOTAL ATTENDANCE' empty for the attendance columns ---
                            let attDisplayVal = (rowConfig.label === 'TOTAL ATTENDANCE') ? '' : (val === 0 ? '' : val);
                            tbodyHtml += `<td class="summary-att-cell" data-day="${i}" data-key="${rowConfig.attKey}">${attDisplayVal}</td>`;
                        });

                        // 2. Render the Work Plan section cells (Columns 10+)
                        uniquework_name.forEach(wn => {
                            for (let i = 0; i < 7; i++) {
                                let displayVal = "";
                                // --- REMAINING UNCHANGED: Keep calculation active for work plan blocks ---
                                if (rowConfig.label === 'TOTAL ATTENDANCE') {
                                    let total = (workStats[wn].dp[i] || 0) + (workStats[wn].up[i] || 0);
                                    displayVal = total > 0 ? total : "";
                                }
                                tbodyHtml += `<td class="total-cell" data-rowtype="${rowConfig.type}" data-workname="${wn}" data-day="${i}">${displayVal}</td>`;
                            }
                        });
                        tbodyHtml += '</tr>';
                    });

                    tbodyHtml += `<tr class="summary-row" style="font-weight:bold; background-color:#ffffff !important;">` +
                        `<td class="merged-style-left">ADDITIONAL INFO</td>` +
                        `<td class="merged-style-middle"></td>` +
                        `<td class="merged-style-right"></td>`;

                    for (let i = 0; i < 7; i++) { tbodyHtml += `<td></td>`; }
                    uniquework_name.forEach((wn) => {
                        for (let i = 0; i < 7; i++) {
                            let d = moment(startDate).add(i, 'days').format('YYYY-MM-DD');
                            let info = dailyAdditionalMap[`${d}_${wn}`] || "";
                            tbodyHtml += `<td><div class="vertical-text">${info}</div></td>`;
                        }
                    });
                    tbodyHtml += '</tr>';

                    // 2. Safely apply headers and content to BOTH separate tables explicitly
                    targetTableIds.forEach(id => {
                        $(id).find('thead').html(theadHtml);
                        $(id).find('tbody').html(tbodyHtml);
                    });

                    // Injection of CSS Rules
                    const whiteRowStylePatch = `
                    <style id="forceWhiteTableLayout">
                        #tableRep, #tableRepNormal, #tableRepEng, #tableRepCI,
                        #tableRep tbody tr, #tableRepNormal tbody tr, #tableRepEng tbody tr, #tableRepCI tbody tr,
                        #tableRep tbody td, #tableRepNormal tbody td, #tableRepEng tbody td, #tableRepCI tbody td {
                            background-color: #ffffff !important;
                        }
                        .DTFC_LeftBodyWrapper, .DTFC_LeftBodyWrapper table, .DTFC_LeftBodyWrapper tbody tr td {
                            background-color: #ffffff !important;
                        }
                        #tableRep thead th, #tableRepNormal thead th, #tableRepEng thead th, #tableRepCI thead th,
                        .dataTables_scrollHead table thead th,
                        .DTFC_LeftHeadWrapper table thead th {
                            text-align: center !important;
                            vertical-align: middle !important;
                        }
                        .merged-style-left { border-right: none !important; text-align: left !important; }
                        .merged-style-middle { border-left: none !important; border-right: none !important; }
                        .merged-style-right { border-left: none !important; }
                    </style>`;
                    $('#forceWhiteTableLayout').remove();
                    $('head').append(whiteRowStylePatch);

                   function getFooterDataArray() {
                        let rows = [];
                        footerMapping.forEach(rowConfig => {
                            let fullRow = [rowConfig.label, '', ''];
        
                            // Update CSV/Excel generation for attendance columns
                            attStats[rowConfig.attKey].forEach(val => { 
                                // --- CHANGED: Keep it empty on export for TOTAL ATTENDANCE ---
                                let exportAttVal = (rowConfig.label === 'TOTAL ATTENDANCE') ? '' : (val === 0 ? '' : String(val));
                                fullRow.push(exportAttVal); 
                            });
        
                            uniquework_name.forEach(wn => {
                                for (let i = 0; i < 7; i++) {
                                    let displayVal = "";
                                    if (rowConfig.label === 'TOTAL ATTENDANCE') {
                                        let total = (workStats[wn].dp[i] || 0) + (workStats[wn].up[i] || 0);
                                        displayVal = total > 0 ? String(total) : "";
                                    }
                                    fullRow.push(displayVal);
                                }
                            });
                            rows.push(fullRow);
                        });

                        let addInfoRow = ['ADDITIONAL INFO', '', ''];
                        for (let i = 0; i < 7; i++) { addInfoRow.push(''); }
                        uniquework_name.forEach((wn) => {
                            for (let i = 0; i < 7; i++) {
                                let d = moment(startDate).add(i, 'days').format('YYYY-MM-DD');
                                addInfoRow.push(dailyAdditionalMap[`${d}_${wn}`] || "");
                            }
                        });
                        rows.push(addInfoRow);
                        return rows;
                    }

                    function getCleanCellData(node) {
                        let $node = $(node);
                        let $toggleBtn = $node.find('.workplan-toggle');
                        if ($toggleBtn.length > 0) {
                            let code = $toggleBtn.data('code');
                            if (code === 'dp') return '+';
                            if (code === 'up') return '-';
                            if (code === 'pl') return '|';
                            return '';
                        }
                        let $span = $node.find('span');
                        if ($span.length > 0) return $span.text().trim();
                        return $node.text().trim();
                    }

                    function getExcelColumnName(colIdx) {
                        let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
                        let columnName = "";
                        while (colIdx >= 0) {
                            columnName = alphabet[colIdx % 26] + columnName;
                            colIdx = Math.floor(colIdx / 26) - 1;
                        }
                        return columnName;
                    }

                    // 3. Initialize DataTable on EACH table distinctly
                    targetTableIds.forEach(id => {
                        if ($(id).length > 0) {
                            $(id).addClass('table table-bordered').DataTable({
                                dom: '<"selected-values"fB>rtip',
                                buttons: [
                                    {
                                        extend: 'excel',
                                        filename: function () {
                                            let fileKmuj = typeof kmuj !== 'undefined' ? kmuj : '';
                                            let fileSection = typeof section !== 'undefined' ? section : '';
                                            let fileSdate = typeof sdate !== 'undefined' ? sdate : '';
                                            let fileEdate = typeof edate !== 'undefined' ? edate : '';
                                            return 'WeeklyProgramme(R1) ' + fileKmuj + '-' + fileSection + '_' + fileSdate + '_to_' + fileEdate;
                                        },
                                        title: null,
                                        header: false,
                                        exportOptions: {
                                            rows: ':visible',
                                            format: { body: function (d, r, c, n) { return getCleanCellData(n); } }
                                        },
                                        customize: function (xlsx) {
                                            let sheet = xlsx.xl.worksheets['sheet1.xml'];
                                            let styleSheet = xlsx.xl['styles.xml'];
                                            let parser = new DOMParser();

                                            // Helper function to safely parse and import XML string nodes across browsers
                                            function parseXmlNode(xmlStr) {
                                                return sheet.importNode(parser.parseFromString(xmlStr, "text/xml").documentElement, true);
                                            }

                                            // =========================================================================
                                            // 1. INJECT THIN BORDER DEFINITION INTO STYLESHEET
                                            // =========================================================================
                                            let borders = styleSheet.getElementsByTagName('borders')[0];
                                            let newBorderXml = `<border>` +
                                                `<left style="thin"><color indexed="64"/></left>` +
                                                `<right style="thin"><color indexed="64"/></right>` +
                                                `<top style="thin"><color indexed="64"/></top>` +
                                                `<bottom style="thin"><color indexed="64"/></bottom>` +
                                                `</border>`;
                                            borders.appendChild(styleSheet.importNode(parser.parseFromString(newBorderXml, "text/xml").documentElement, true));
                                            let borderIdx = borders.childNodes.length - 1;

                                            // =========================================================================
                                            // 2. CREATE CUSTOM CELL STYLES
                                            // =========================================================================
                                            let cellXfs = styleSheet.getElementsByTagName('cellXfs')[0];

                                            // Helper to append style
                                            function addStyle(border, horizontal, vertical, textRotation) {
                                                let xf = styleSheet.createElement('xf');
                                                xf.setAttribute('numFmtId', '0');
                                                xf.setAttribute('fontId', '0');
                                                xf.setAttribute('fillId', '0');
                                                xf.setAttribute('borderId', border ? borderIdx : '0');
                                                xf.setAttribute('xfId', '0');
                                                if (border) xf.setAttribute('applyBorder', '1');
                                                xf.setAttribute('applyAlignment', '1');

                                                let align = styleSheet.createElement('alignment');
                                                if (horizontal) align.setAttribute('horizontal', horizontal);
                                                if (vertical) align.setAttribute('vertical', vertical);
                                                if (textRotation) align.setAttribute('textRotation', textRotation);

                                                xf.appendChild(align);
                                                cellXfs.appendChild(xf);
                                                return cellXfs.childNodes.length - 1;
                                            }

                                            // Style A: Thin Border + Center Alignment
                                            let centerHeaderStyleIdx = addStyle(true, 'center', 'center', null);
                                            let borderedStyleIdx = centerHeaderStyleIdx;

                                            // Style B: Thin Border + 90° Text Rotation + Center Alignment
                                            let rotBorderedStyleIdx = addStyle(true, 'center', 'center', '90');

                                            // Style C: Thin Border + Left Alignment
                                            let leftLabelStyleIdx = addStyle(true, 'left', 'center', null);

                                            // Style D: No Border + Right Alignment
                                            let rightAlignStyleIdx = addStyle(false, 'right', 'center', null);

                                            // =========================================================================
                                            // 3. DETERMINE COLUMN BOUNDS & SPANS DYNAMICALLY
                                            // =========================================================================
                                            let maxBodyCols = 0;
                                            $('row', sheet).each(function () {
                                                let count = $(this).find('c').length;
                                                if (count > maxBodyCols) maxBodyCols = count;
                                            });

                                            let header1Len = (typeof headerRow1 !== 'undefined' && headerRow1) ? headerRow1.length : 0;
                                            let numCols = Math.max(header1Len, maxBodyCols);
                                            let lastColLetter = getExcelColumnName(numCols - 1);

                                            // Column spans across the rightmost 5 columns
                                            let startLabelColIdx = Math.max(0, numCols - 5);
                                            let endLabelColIdx = Math.max(0, numCols - 3);
                                            let startValColIdx = Math.max(0, numCols - 2);

                                            let startLabelColLetter = getExcelColumnName(startLabelColIdx);
                                            let endLabelColLetter = getExcelColumnName(endLabelColIdx);
                                            let startValColLetter = getExcelColumnName(startValColIdx);
                                            let distSecEndColLetter = getExcelColumnName(Math.max(0, startLabelColIdx - 1));

                                            // Safe global variables evaluation
                                            let titleReportDateRange = typeof reportDateRange !== 'undefined' ? reportDateRange : '';
                                            let titleKmuj = typeof kmuj !== 'undefined' ? kmuj : '';
                                            let titleSection = typeof section !== 'undefined' ? section : '';
                                            let titleWeekNo = typeof weekNo !== 'undefined' ? weekNo : '';
                                            let titleWeekEndingDate = typeof weekEndingDate !== 'undefined' ? weekEndingDate : '';

                                            // =========================================================================
                                            // 4. BUILD TOP HEADER ROWS (1 TO 6)
                                            // =========================================================================
                                            let row1Xml = `<row r="1"><c t="inlineStr" r="A1"><is><t><![CDATA[KTM BERHAD - WEEKLY PROGRAMME (R1) - ${titleReportDateRange}]]></t></is></c></row>`;

                                            let row2Xml = `<row r="2">` +
                                                `<c t="inlineStr" r="A2"><is><t><![CDATA[DISTRICT: KMUJ ${titleKmuj}]]></t></is></c>` +
                                                `<c t="inlineStr" r="${startLabelColLetter}2" s="${rightAlignStyleIdx}"><is><t><![CDATA[WEEK NO:]]></t></is></c>` +
                                                `<c t="inlineStr" r="${startValColLetter}2" s="${rightAlignStyleIdx}"><is><t><![CDATA[${titleWeekNo}]]></t></is></c>` +
                                                `</row>`;

                                            let row3Xml = `<row r="3">` +
                                                `<c t="inlineStr" r="A3"><is><t><![CDATA[SECTION: MUJ ${titleSection}]]></t></is></c>` +
                                                `<c t="inlineStr" r="${startLabelColLetter}3" s="${rightAlignStyleIdx}"><is><t><![CDATA[WEEK ENDING:]]></t></is></c>` +
                                                `<c t="inlineStr" r="${startValColLetter}3" s="${rightAlignStyleIdx}"><is><t><![CDATA[${titleWeekEndingDate}]]></t></is></c>` +
                                                `</row>`;

                                            let row4Xml = '<row r="4"></row>';

                                            let row5Xml = '<row r="5" ht="24" customHeight="1">';
                                            let row6Xml = '<row r="6" ht="20" customHeight="1">';
                                            for (let c = 0; c < numCols; c++) {
                                                let colRef = getExcelColumnName(c);
                                                let val1 = (typeof headerRow1 !== 'undefined' && headerRow1[c] != null) ? String(headerRow1[c]).toUpperCase() : '';
                                                let val2 = (typeof headerRow2 !== 'undefined' && headerRow2[c] != null) ? String(headerRow2[c]).toUpperCase() : '';

                                                row5Xml += `<c t="inlineStr" r="${colRef}5" s="${centerHeaderStyleIdx}"><is><t><![CDATA[${val1}]]></t></is></c>`;
                                                row6Xml += `<c t="inlineStr" r="${colRef}6" s="${centerHeaderStyleIdx}"><is><t><![CDATA[${val2}]]></t></is></c>`;
                                            }
                                            row5Xml += '</row>';
                                            row6Xml += '</row>';

                                            // =========================================================================
                                            // 5. SHIFT BODY ROWS & REBUILD ALL CELLS
                                            // =========================================================================
                                            let finalBodyRowIdx = 6;

                                            $('row', sheet).each(function () {
                                                let $row = $(this);
                                                let currentDocRow = parseInt($row.attr('r'));
                                                let newDocRow = currentDocRow + 6;

                                                $row.attr('r', newDocRow);
                                                if (newDocRow > finalBodyRowIdx) { finalBodyRowIdx = newDocRow; }

                                                let existingCells = {};
                                                $('c', $row).each(function () {
                                                    let cellRef = $(this).attr('r');
                                                    let colPart = cellRef.match(/[A-Z]+/)[0];
                                                    existingCells[colPart] = $(this);
                                                });

                                                $row.empty();

                                                for (let c = 0; c < numCols; c++) {
                                                    let colRef = getExcelColumnName(c);
                                                    let cellRef = `${colRef}${newDocRow}`;

                                                    if (existingCells[colRef]) {
                                                        let $c = existingCells[colRef];
                                                        $c.attr('r', cellRef);
                                                        $c.attr('s', borderedStyleIdx);
                                                        $row.append($c);
                                                    } else {
                                                        $row.append(`<c t="inlineStr" r="${cellRef}" s="${borderedStyleIdx}"><is><t></t></is></c>`);
                                                    }
                                                }
                                            });

                                            let sheetData = sheet.getElementsByTagName('sheetData')[0];
                                            let footerMappingLen = (typeof footerMapping !== 'undefined' && footerMapping) ? footerMapping.length : 0;

                                            $('row', sheetData).each(function () {
                                                let rIdx = parseInt($(this).attr('r'));
                                                if (rIdx > (finalBodyRowIdx - (footerMappingLen + 1))) {
                                                    $(this).remove();
                                                }
                                            });

                                            // =========================================================================
                                            // 6. GENERATE SUMMARY FOOTERS
                                            // =========================================================================
                                            let currentExcelRow = (finalBodyRowIdx - (footerMappingLen + 1)) + 1;
                                            let footerRowsData = typeof getFooterDataArray === 'function' ? getFooterDataArray() : [];
                                            let summaryMergeRows = [];

                                            footerRowsData.forEach((rowArr) => {
                                                let isAddInfoRow = (rowArr[0] === 'ADDITIONAL INFO');

                                                let footerRowXml = isAddInfoRow
                                                    ? `<row r="${currentExcelRow}" ht="140" customHeight="1">`
                                                    : `<row r="${currentExcelRow}">`;

                                                summaryMergeRows.push(currentExcelRow);

                                                for (let cIdx = 0; cIdx < numCols; cIdx++) {
                                                    let colRef = getExcelColumnName(cIdx);
                                                    let cellVal = rowArr[cIdx];
                                                    let cleanVal = (cellVal === null || cellVal === undefined) ? "" : String(cellVal).trim();

                                                    if (isAddInfoRow) {
                                                        cleanVal = cleanVal.toUpperCase();
                                                    }

                                                    let isNumeric = cleanVal !== "" && /^\d+$/.test(cleanVal);

                                                    let currentStyle = borderedStyleIdx;
                                                    if (cIdx === 0) {
                                                        currentStyle = leftLabelStyleIdx;
                                                    } else if (isAddInfoRow) {
                                                        currentStyle = rotBorderedStyleIdx;
                                                    }

                                                    if (isNumeric && !isAddInfoRow) {
                                                        footerRowXml += `<c r="${colRef}${currentExcelRow}" s="${currentStyle}"><v>${cleanVal}</v></c>`;
                                                    } else {
                                                        footerRowXml += `<c t="inlineStr" r="${colRef}${currentExcelRow}" s="${currentStyle}"><is><t><![CDATA[${cleanVal}]]></t></is></c>`;
                                                    }
                                                }

                                                footerRowXml += `</row>`;
                                                sheetData.appendChild(parseXmlNode(footerRowXml));
                                                currentExcelRow++;
                                            });

                                            // =========================================================================
                                            // 7. LEGEND & FOOTER SIGNATURES
                                            // =========================================================================
                                            sheetData.appendChild(parseXmlNode(`<row r="${currentExcelRow}"></row>`));
                                            currentExcelRow++;

                                            // --- Column Indexes ---
                                            // Time column merges across 2 columns at the far right
                                            let timeColIdxStart = Math.max(3, numCols - 2);
                                            let timeColIdxEnd = Math.max(timeColIdxStart, numCols - 1);

                                            // Label column merges across 7-8 columns ending right before the time column
                                            let pwdEndColIdx = Math.max(2, timeColIdxStart - 1);
                                            let pwdColIdx = Math.max(2, pwdEndColIdx - 10);

                                            let pwdColLetter = getExcelColumnName(pwdColIdx);
                                            let pwdEndColLetter = getExcelColumnName(pwdEndColIdx);
                                            let timeStartColLetter = getExcelColumnName(timeColIdxStart);
                                            let timeEndColLetter = getExcelColumnName(timeColIdxEnd);

                                            let legendMergeRows = [];

                                            let infoLayoutData = [
                                                { a: "C.E - Compassionate Leave", c: "PANDUAN WAKTU KERJA", d: "" },
                                                { a: "C.T - Yearly Leave", c: "Isnin - Khamis", d: "(0700 - 1645)" },
                                                { a: "T.H - Not Present", c: "Waktu Rehat", d: "(1200 - 1300)" },
                                                { a: "S - Sick", c: "Jumaat", d: "(0700 - 1300)" },
                                                { a: "P.H - Public Holiday", c: "Perondaan Landasan, Off Day, Rehat Minggu, Cuti Umum dan Gantian", d: "(0700 - 1500)" }
                                            ];

                                            infoLayoutData.forEach(info => {
                                                let rowXml = `<row r="${currentExcelRow}">`;

                                                // Left legend (Column A)
                                                if (info.a) {
                                                    rowXml += `<c t="inlineStr" r="A${currentExcelRow}"><is><t><![CDATA[${info.a}]]></t></is></c>`;
                                                }

                                                // Merged multi-column span for text (7-8 columns)
                                                if (info.c) {
                                                    rowXml += `<c t="inlineStr" r="${pwdColLetter}${currentExcelRow}"><is><t><![CDATA[${info.c}]]></t></is></c>`;

                                                    // Add empty XML cells for spanned columns
                                                    for (let c = pwdColIdx + 1; c <= pwdEndColIdx; c++) {
                                                        let colName = getExcelColumnName(c);
                                                        rowXml += `<c t="inlineStr" r="${colName}${currentExcelRow}"><is><t></t></is></c>`;
                                                    }

                                                    if (pwdEndColIdx > pwdColIdx) {
                                                        legendMergeRows.push(`${pwdColLetter}${currentExcelRow}:${pwdEndColLetter}${currentExcelRow}`);
                                                    }
                                                }

                                                // Merged 2-column span for time at the far right
                                                if (info.d) {
                                                    rowXml += `<c t="inlineStr" r="${timeStartColLetter}${currentExcelRow}" s="${rightAlignStyleIdx}"><is><t><![CDATA[${info.d}]]></t></is></c>`;

                                                    // Empty cell for the second merged time column
                                                    if (timeColIdxEnd > timeColIdxStart) {
                                                        rowXml += `<c t="inlineStr" r="${timeEndColLetter}${currentExcelRow}" s="${rightAlignStyleIdx}"><is><t></t></is></c>`;
                                                        legendMergeRows.push(`${timeStartColLetter}${currentExcelRow}:${timeEndColLetter}${currentExcelRow}`);
                                                    }
                                                }

                                                rowXml += `</row>`;

                                                sheetData.appendChild(parseXmlNode(rowXml));
                                                currentExcelRow++;
                                            });

                                            sheetData.appendChild(parseXmlNode(`<row r="${currentExcelRow}"></row>`));
                                            currentExcelRow++;

                                            // Safely evaluate preparer name
                                            let preparerName = (typeof updatedByPerson !== 'undefined' && updatedByPerson) ? updatedByPerson : '';

                                            sheetData.appendChild(parseXmlNode(`<row r="${currentExcelRow}"><c t="inlineStr" r="A${currentExcelRow}"><is><t><![CDATA[PREPARED BY PWI: ${preparerName}]]></t></is></c></row>`));
                                            currentExcelRow++;

                                            sheetData.appendChild(parseXmlNode(`<row r="${currentExcelRow}"><c t="inlineStr" r="A${currentExcelRow}"><is><t><![CDATA[RECEIVED BY GANGER]]></t></is></c></row>`));

                                            // Insert top header rows back-to-front at the start of sheetData
                                            sheetData.insertBefore(parseXmlNode(row6Xml), sheetData.firstChild);
                                            sheetData.insertBefore(parseXmlNode(row5Xml), sheetData.firstChild);
                                            sheetData.insertBefore(parseXmlNode(row4Xml), sheetData.firstChild);
                                            sheetData.insertBefore(parseXmlNode(row3Xml), sheetData.firstChild);
                                            sheetData.insertBefore(parseXmlNode(row2Xml), sheetData.firstChild);
                                            sheetData.insertBefore(parseXmlNode(row1Xml), sheetData.firstChild);

                                            // =========================================================================
                                            // 8. MERGE CELLS (DYNAMIC & SAFE)
                                            // =========================================================================
                                            let mergeCells = sheet.getElementsByTagName('mergeCells')[0];
                                            if (!mergeCells) {
                                                mergeCells = sheet.createElement('mergeCells');
                                                sheet.appendChild(mergeCells);
                                            } else {
                                                while (mergeCells.firstChild) {
                                                    mergeCells.removeChild(mergeCells.firstChild);
                                                }
                                            }

                                            let mergeRanges = [];

                                            // Static vertical header merges
                                            mergeRanges.push('A5:A6'); // Staff No
                                            mergeRanges.push('B5:B6'); // Name
                                            mergeRanges.push('C5:C6'); // Designation

                                            // Meta info title merges
                                            mergeRanges.push(`A1:${lastColLetter}1`);
                                            mergeRanges.push(`A2:${distSecEndColLetter}2`);
                                            mergeRanges.push(`A3:${distSecEndColLetter}3`);

                                            // Top right metadata merges
                                            mergeRanges.push(`${startLabelColLetter}2:${endLabelColLetter}2`);
                                            mergeRanges.push(`${startLabelColLetter}3:${endLabelColLetter}3`);
                                            mergeRanges.push(`${startValColLetter}2:${lastColLetter}2`);
                                            mergeRanges.push(`${startValColLetter}3:${lastColLetter}3`);

                                            // Dynamic category merges (Row 5)
                                            let categoryStartCols = [];
                                            if (typeof headerRow1 !== 'undefined' && headerRow1) {
                                                for (let c = 3; c < numCols; c++) {
                                                    let colVal = headerRow1[c];
                                                    if (colVal !== undefined && colVal !== null && String(colVal).trim() !== '') {
                                                        categoryStartCols.push(c);
                                                    }
                                                }
                                            }

                                            for (let i = 0; i < categoryStartCols.length; i++) {
                                                let startIdx = categoryStartCols[i];
                                                let nextStartIdx = (i + 1 < categoryStartCols.length) ? categoryStartCols[i + 1] : numCols;
                                                let endIdx = Math.min(startIdx + 6, nextStartIdx - 1);

                                                if (endIdx > startIdx) {
                                                    let startColLetter = getExcelColumnName(startIdx);
                                                    let endColLetter = getExcelColumnName(endIdx);
                                                    mergeRanges.push(`${startColLetter}5:${endColLetter}5`);
                                                }
                                            }

                                            // Summary footer merges (A to C)
                                            summaryMergeRows.forEach(rIdx => {
                                                mergeRanges.push(`A${rIdx}:C${rIdx}`);
                                            });

                                            // Add 7-8 column description merges & 2-column time merges for "Panduan Waktu Kerja"
                                            legendMergeRows.forEach(range => {
                                                mergeRanges.push(range);
                                            });

                                            // Write merge ranges back to OpenXML
                                            mergeRanges.forEach(range => {
                                                let mergeCell = sheet.createElement('mergeCell');
                                                mergeCell.setAttribute('ref', range);
                                                mergeCells.appendChild(mergeCell);
                                            });

                                            mergeCells.setAttribute('count', mergeCells.childNodes.length);
                                        }
                                    }
                                ],
                                responsive: false,
                                autoWidth: false,
                                paging: false,
                                ordering: false,
                                fixedColumns: { left: 3 },
                                columnDefs: [
                                    { targets: '_all', className: 'dt-center head-center' }
                                ],
                                createdRow: function (row) {
                                    if ($(row).hasClass('summary-row')) {
                                        $('td', row).css('background-color', '#ffffff');
                                        $('td:gt(2)', row).addClass('text-nowrap align-middle text-center');
                                    } else {
                                        $('td', row).addClass('text-nowrap align-middle text-center');
                                    }
                                },
                                initComplete: function () {
                                    setTimeout(() => {
                                        this.api().columns.adjust();
                                    }, 200);
                                }
                            });
                        }
                    });

                    // Metadata UI Attachment
                    let topMetadataHtml = `
                    <div id="tableMetadataViewTop" class="mt-2 mb-3 p-2" style="font-size: 15px; border-radius: 0 4px 4px 0;">
                        <div style="display: flex; justify-content: flex-end; align-items: flex-start; width: 100%;">
                            <div style="text-align: right; padding-right: 15px;">
                                <div style="margin-bottom: 4px;"><strong>Week No :</strong> ${weekNumber}</div>
                                <div><strong>Week Ending :</strong> ${weekEndingStr}</div>
                                <br>
                                <div><strong>Prepared By PWI:</strong> ${updatedByPerson}</div>
                            </div>
                        </div>
                    </div>`;
                    $('.selected-values').first().after(topMetadataHtml);

               

                    // ==========================================
                    // Event delegation triggers (Stay unchanged)
                    // ==========================================

                },
                error: function () { swarning("Failed to load reports."); }
            });
        }

    </script>
}



