@section scripts{
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedcolumns/4.3.0/css/fixedcolumns.dataTables.min.css">
    <script src="https://cdn.datatables.net/fixedcolumns/4.3.0/js/dataTables.fixedColumns.min.js"></script>
    <script src="~/assets/scripts/dashboard.js"></script>
    <script src="~/assets/plugins/daterangepicker/daterangepicker.js"></script>
    <script src="~/assets/plugins/select2/select2.min.js"></script>
    <script type="text/javascript">


     $(document).ready(function () {
            checkSess();
            listSection();
            listKMUJ();
            listKMUJonReg();
            listSectionOnKMUJ();
            listReports();

            var lvl = localStorage.getItem("lvlI");

            $("#contentAdmin, #contentEngineer, #contentCI, #contentNormal, #contentOthers").hide();

            if (lvl === "1" || lvl === "5") {
                $("#contentAdmin").show();

                $("#kmuj, #section").on('change', function () {
                    localStorage.removeItem("selHar");
                    localStorage.removeItem("selHarE");
                    $('#txtDate').val('');

                    var drp = $('#txtDate').data('daterangepicker');
                    drp.setStartDate(moment());
                    drp.setEndDate(moment());
                });

                $('#kmuj').on('change', function (e, selectedSectionValue) {
                    var selectedKmuj = $(this).find('option:selected').text();
                    var selectedKmujVal = $(this).val();

                    console.log("Selected KMUJ Text:", selectedKmuj);

                    if (selectedKmujVal && selectedKmujVal !== "-0" && !selectedKmuj.includes("Select KMUJ")) {
                        $('#section').prop('disabled', false).trigger('change.select2');
                        listSection(selectedKmuj, selectedSectionValue);
                    } else {
                        $('#section')
                            .html('<option value="-0">Select Section</option>')
                            .prop('disabled', true)
                            .trigger('change')
                            .trigger('change.select2');
                    }
                });

                $('#btnSearch').on('click', function () {
                    var kmj = $("#kmuj option:selected").text();
                    var scn = $("#section option:selected").text();

                    localStorage.setItem("selKmj", kmj);
                    localStorage.setItem("selScn", scn);

                    var sdate = localStorage.getItem("selHar") || "";
                    var edate = localStorage.getItem("selHarE") || "";

                    listReports(kmj, scn, sdate, edate);

                    if (sdate !== "") {
                        salertSave('Searching for: ' + sdate + ' to ' + edate);
                    } else {
                        salertSave('Searching all dates for ' + rgn);
                    }
                });

                $("#contentAdmin").off('click', '.attendance-toggle').on('click', '.attendance-toggle', function (e) {
                    e.preventDefault();
                    const $btn = $(this);
                    if ($btn.attr('disabled')) return false;

                    const $span = $btn.find('.attendance-text');
                    const date = $btn.data('date');
                    const empId = $btn.data('emplid');
                    const dayIndex = moment(date).diff(startDate, 'days');
            
                    let oldType = $btn.data('leavetype') || 'valid';
                    if (oldType === '' || oldType === 'NULL' || oldType === 'null') {
                        oldType = 'valid';
                    }

                    // Unify Admin codes with Normal block (using CE)
                    let newType, newDisplay;
                    if (oldType === 'valid')      { newType = 'al'; newDisplay = 'CT'; }
                    else if (oldType === 'al')   { newType = 'mc'; newDisplay = 'S'; }
                    else if (oldType === 'mc')   { newType = 'ab'; newDisplay = 'TH'; }
                    else if (oldType === 'ab')   { newType = 'cs'; newDisplay = 'CE'; } 
                    else                         { newType = 'valid'; newDisplay = ''; }

                    if (attStats[oldType]) attStats[oldType][dayIndex]--;
                    if (attStats[newType]) attStats[newType][dayIndex]++;

                    $btn.data('leavetype', newType);
                    $span.text(newDisplay);

                    footerMapping.forEach(f => {
                        if (attStats[f.attKey]) {
                            let val = attStats[f.attKey][dayIndex];
                            $(`.summary-att-cell[data-day="${dayIndex}"][data-key="${f.attKey}"]`).text(val === 0 ? '' : val);
                        }
                    });

                    // Force explicit 'valid' string map
                    let dbCutiCode = "valid";
                    if (newType === 'al')      dbCutiCode = "CT";
                    else if (newType === 'mc') dbCutiCode = "S";
                    else if (newType === 'ab') dbCutiCode = "TH";
                    else if (newType === 'cs') dbCutiCode = "CE";
                    else if (newType === 'valid') dbCutiCode = "valid";

                    autoSaveStaffAttendance(empId, date, dbCutiCode);
                });
            }

            else if (lvl === "2" || lvl === "6") {
                $("#contentEngineer").show();

                console.log("Full LocalStorage:", localStorage);
                var rgn = localStorage.getItem("usrR");
                console.log("Value of usrR:", rgn);

                listKMUJonReg(rgn, '#kmujEng');

                if (rgn === null) {
                    console.warn("DEBUG: 'usrRE' is missing! Check where you set this value.");
                }

                $('#kmujEng').on('change', function (e, selectedSectionValue) {
                    var selectedKmujText = $(this).find('option:selected').text();
                    var selectedKmujVal = $(this).val();

                    console.log("Selected KMUJ Text:", selectedKmujText);
                    console.log("Selected KMUJ Value:", selectedKmujVal);

                    $('#txtDateEng').val('');
                    localStorage.removeItem("selHar");
                    localStorage.removeItem("selHarE");

                    var drp = $('#txtDateEng').data('daterangepicker');
                    if (drp) {
                        drp.setStartDate(moment());
                        drp.setEndDate(moment());
                    }

                    if (selectedKmujVal && selectedKmujVal !== "-0" && !selectedKmujText.includes("Select KMUJ")) {
                        $('#sectionEng').prop('disabled', false).trigger('change.select2');
                        listSection(selectedKmujText, selectedSectionValue);
                    } else {
                        $('#sectionEng')
                            .html('<option value="-0">Select Section</option>')
                            .prop('disabled', true)
                            .trigger('change')
                            .trigger('change.select2');
                    }
                });

                $('#btnSearchEng').on('click', function () {
                    var kmj = $("#kmujEng option:selected").text();
                    var scn = $("#sectionEng option:selected").text();

                    localStorage.setItem("selKmj", kmj);
                    localStorage.setItem("selScn", scn);

                    var sdate = localStorage.getItem("selHar") || "";
                    var edate = localStorage.getItem("selHarE") || "";

                    listReports(kmj, scn, sdate, edate);

                    if (sdate !== "") {
                        salertSave('Searching for: ' + sdate + ' to ' + edate);
                    } else {
                        salertSave('Searching all dates for ' + rgn);
                    }
                });
            }

            else if (lvl === "3") {
                $("#contentCI").show();

                console.log("Full LocalStorage:", localStorage);
                var kmj = localStorage.getItem("kmuj");
                console.log("Value of kmuj:", kmj);

                listSectionOnKMUJ(kmj, '#sectionCI');

                if (kmj === null) {
                    console.warn("DEBUG: 'kmuj' is missing! Check where you set this value.");
                }

                $("#sectionCI").on('change', function () {
                    localStorage.removeItem("selHar");
                    localStorage.removeItem("selHarE");
                    $('#txtDateCI').val('');

                    var drp = $('#txtDateCI').data('daterangepicker');
                    drp.setStartDate(moment());
                    drp.setEndDate(moment());
                });

                $('#btnSearchCI').on('click', function () {
                    var kmj = localStorage.getItem("kmuj");
                    var scn = $("#sectionCI option:selected").text();

                    localStorage.setItem("selRgn", kmj);
                    localStorage.setItem("selKmj", scn);

                    var sdate = localStorage.getItem("selHar") || "";
                    var edate = localStorage.getItem("selHarE") || "";

                    listReports(kmj, scn, sdate, edate);
