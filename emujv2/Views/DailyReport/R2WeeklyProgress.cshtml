        function listReports(kmuj, section, sdate, edate) {
            $.ajax({
                url: linkDepan + "GetKerja?&Kmuj=" + kmuj + "&Section=" + section + "&SDate=" + sdate + "&Edate=" + edate,
                type: 'GET',
                dataType: 'json',
                beforeSend: function (request) {
                    request.setRequestHeader("Token", localStorage.getItem('main'));
                },
                success: function (data) {
                    // Clear and destroy existing tables to prevent re-initialization errors
                    if ($.fn.DataTable.isDataTable('#tableRep, #tableRepNormal, #tableRepEng, #tableRepCI')) {
                        $('#tableRep, #tableRepNormal, #tableRepEng, #tableRepCI').DataTable().clear().destroy();
                    }

                    if (!data || !Array.isArray(data) || !data.length) {
                        console.warn('No data returned.');
                        initializeEmptyTables();
                        return;
                    }

                    // ==========================================
                    // 1. RESOLVE VERIFIER & VALIDATOR INFO
                    // ==========================================
                    const validRow = data.find(item =>
                        (item.verifier_name || item.Verifier_Name || "").trim() !== '' ||
                        (item.validated_name || item.Validated_Name || "").trim() !== ''
                    ) || data[0];

                    // Helper function to format date to dd/mm/yyyy hh:mm
                    function formatToCustomDateTime(rawDate) {
                        if (!rawDate) return "";
                        const d = new Date(rawDate);
                        if (isNaN(d.getTime())) return "";

                        const day = String(d.getDate()).padStart(2, '0');
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const year = d.getFullYear();

                        const hours = String(d.getHours()).padStart(2, '0');
                        const minutes = String(d.getMinutes()).padStart(2, '0');

                        return `${day}/${month}/${year} ${hours}:${minutes}`;
                    }

                    let verifierName = (validRow.verifier_name || validRow.Verifier_Name || "").trim() || "-";
                    let verifiedAtDate = "";
                    const rawVerifyDate = validRow.verified_at || validRow.Verified_At;
                    if (rawVerifyDate && verifierName !== "-") {
                        verifiedAtDate = formatToCustomDateTime(rawVerifyDate);
                    }

                    let validatorName = (validRow.validated_name || validRow.Validated_Name || "").trim() || "-";
                    let validatedAtDate = "";
                    const rawValidateDate = validRow.validated_at || validRow.Validated_At;
                    if (rawValidateDate && validatorName !== "-") {
                        validatedAtDate = formatToCustomDateTime(rawValidateDate);
                    }

                    // ==========================================
                    // 2. CONDITIONAL BUTTON & TEXT DISPLAY
                    // ==========================================
                    const isValidated = validatorName !== "-" && validatedAtDate !== "";
                    const isVerified = verifierName !== "-" && verifiedAtDate !== "";

                    $('#htmlPreparedByPWI').text(validatorName);
                    $('#htmlPreparedAt').text(validatedAtDate);
                    $('#htmlVerifiedByPW').text(verifierName);
                    $('#htmlVerifiedAt').text(verifiedAtDate);

                    $('#htmlPreparedByPWIEng').text(validatorName);
                    $('#htmlPreparedAtEng').text(validatedAtDate);
                    $('#htmlVerifiedByPWEng').text(verifierName);
                    $('#htmlVerifiedAtEng').text(verifiedAtDate);

                    // --- CI SECTION (Verify Action) ---
                    $('#htmlValidatedByPWI_CI').text(validatorName);
                    $('#htmlValidatedAtCI').text(validatedAtDate);
                    $('#htmlVerifiedByPWCI').text(verifierName);

                    if (isVerified) {
                        $('#btnVerifyCI').hide();
                        $('#htmlVerifiedAtCI_Display').text(verifiedAtDate).show();
                    } else if (isValidated) {
                        $('#btnVerifyCI').prop('disabled', false).show();
                        $('#htmlVerifiedAtCI_Display').hide();
                    } else {
                        $('#btnVerifyCI').prop('disabled', true).show();
                        $('#htmlVerifiedAtCI_Display').hide();
                    }

                    // --- NORMAL SECTION (Validate Action) ---
                    $('#htmlValidatedByPWNormal').text(validatorName);
                    if (isValidated) {
                        $('#btnValidateNormal').hide();
                        $('#htmlValidatedAtNormal').text(validatedAtDate).show();
                    } else {
                        $('#btnValidateNormal').show();
                        $('#htmlValidatedAtNormal').hide();
                    }
                    $('#htmlVerifiedByPWNormal_ReadOnly').text(verifierName);
                    $('#htmlVerifiedAtNormal_ReadOnly').text(verifiedAtDate);

                    // ==========================================
                    // 3. CAPTURE REPORT CODES FOR BUTTONS
                    // ==========================================
                    let uniqueReportCodes = [...new Set(data.map(i => (i.rpt_code || "").trim()).filter(i => i))];
                    $('#btnVerifyCI, #btnValidateNormal').data('rpt-codes', uniqueReportCodes);

                    // ==========================================
                    // 4. PREPARE & GROUP DATA (CHRONOLOGICAL NOTES)
                    // ==========================================
                    let finalData = [];
                    let groupedMap = new Map();
                    let uniqueDates = new Set();
                    let overallTimeSum = 0;

                    const validStaffRow = data.find(i => (i.staff_name || i.Staff_Name || i.staffName));
                    const updatedByPerson = validStaffRow ? (validStaffRow.staff_name || validStaffRow.Staff_Name || validStaffRow.staffName).trim() : "-";

                    data.forEach(item => {
                        let key = `${item.work_cat_id}_${item.work_name}`;

                        if (!groupedMap.has(key)) {
                            groupedMap.set(key, {
                                work_cat_id: item.work_cat_id,
                                work_cat_name: item.work_cat_name,
                                work_name: item.work_name,
                                notesList: [], // Store objects: { date: Date, text: string }
                                TotalTime: 0
                            });
                        }

                        let existingRow = groupedMap.get(key);

                        // Process all keys inside item
                        Object.keys(item).forEach(dateKey => {
                            const ignoredKeys = [
                                "work_cat_id", "work_cat_name", "work_name", "TotalTime",
                                "daily_additional", "Daily_Additional", "staff_name", "Staff_Name",
                                "staffName", "rpt_code", "rptCode", "Rpt_Code", "verified_by",
                                "Verified_By", "verifiedBy", "verifier_name", "Verifier_Name",
                                "verifierName", "verified_at", "Verified_At", "validated_name",
                                "Validated_Name", "validated_at", "Validated_At", "validated_by"
                            ];

                            // Check if key is a Date column (e.g., "05/07/2026")
                            if (!ignoredKeys.some(k => dateKey.toLowerCase() === k.toLowerCase())) {
                                let val = (parseFloat(item[dateKey]) || 0);

                                // Collect daily_additional and associate it with this dateKey entry
                                let rawNote = item.daily_additional || item.Daily_Additional;
                                if (val > 0 && rawNote && typeof rawNote === 'string' && rawNote.trim() !== '') {
                                    const parts = dateKey.split('/');
                                    const dateObj = new Date(parts[2], parts[1] - 1, parts[0]);

                                    // Avoid duplicate identical notes for the same date entry
                                    let exists = existingRow.notesList.some(n => n.text === rawNote.trim() && n.date.getTime() === dateObj.getTime());
                                    if (!exists) {
                                        existingRow.notesList.push({
                                            date: dateObj,
                                            text: rawNote.trim()
                                        });
                                    }
                                }

                                if (val > 0) {
                                    const parts = dateKey.split('/');
                                    const multiplier = (new Date(parts[2], parts[1] - 1, parts[0]).getDay() >= 1 && new Date(parts[2], parts[1] - 1, parts[0]).getDay() <= 4) ? 8.75 : 5;
                                    let calculatedValue = val * multiplier;

                                    let existingDateVal = parseFloat(existingRow[dateKey]) || 0;
                                    existingRow[dateKey] = existingDateVal + calculatedValue;

                                    existingRow.TotalTime += calculatedValue;
                                    overallTimeSum += calculatedValue;
                                }
                                uniqueDates.add(dateKey);
                            }
                        });
                    });

                    // Format grouped data for DataTables
                    groupedMap.forEach(row => {
                        // Sort notes chronologically (Ascending by Date)
                        row.notesList.sort((a, b) => a.date - b.date);

                        // Extract ordered text strings and join them with ', '
                        let orderedNotes = row.notesList.map(n => n.text);
                        row.daily_additional = orderedNotes.length > 0 ? orderedNotes.join(', ') : '';

                        // Remove temporary array before passing to DataTables
                        delete row.notesList;

                        // Format calculated values to 2 decimal places
                        uniqueDates.forEach(dateKey => {
                            let dateVal = row[dateKey];
                            row[dateKey] = (dateVal && dateVal > 0) ? dateVal.toFixed(2) : '';
                        });

                        row.TotalTime = row.TotalTime.toFixed(2);
                        finalData.push(row);
                    });

                    // Sorting unique dates headers
                    let sortedDates = Array.from(uniqueDates).sort((a, b) => {
                        const pA = a.split('/'), pB = b.split('/');
                        return new Date(pA[2], pA[1] - 1, pA[0]) - new Date(pB[2], pB[1] - 1, pB[0]);
                    });

                    // ==========================================
                    // 5. THE "NO DATA" CHECK
                    // ==========================================
                    if (overallTimeSum === 0) {
                        initializeEmptyTables(sortedDates);
                        resetSummaryLabels(updatedByPerson);
                        return;
                    }

                    // ==========================================
                    // 6. AGGREGATIONS & CALCULATIONS
                    // ==========================================
                    let totalManHoursForGangs = finalData.reduce((sum, row) => sum + parseFloat(row.TotalTime || 0), 0);
                    let offTrackWorksTotal = finalData.reduce((sum, row) => Number(row.work_cat_id) === 5 ? sum + parseFloat(row.TotalTime || 0) : sum, 0);
                    let othersCategories = [11, 12, 14, 15, 16, 17];
                    let totalOthers = finalData.reduce((sum, row) => othersCategories.includes(Number(row.work_cat_id)) ? sum + parseFloat(row.TotalTime || 0) : sum, 0);
                    let totalOnTrackWorks = totalManHoursForGangs - offTrackWorksTotal - totalOthers;

                    let perOnTrack = (totalManHoursForGangs > 0) ? ((totalOnTrackWorks / totalManHoursForGangs) * 100).toFixed(2) : "0.00";
                    let perOffTrack = (totalManHoursForGangs > 0) ? ((offTrackWorksTotal / totalManHoursForGangs) * 100).toFixed(2) : "0.00";
                    let perOthers = (totalManHoursForGangs > 0) ? ((totalOthers / totalManHoursForGangs) * 100).toFixed(2) : "0.00";

                    let totalRow = { work_cat_id: '', work_cat_name: 'TOTAL', work_name: '', TotalTime: totalManHoursForGangs.toFixed(2) };
                    sortedDates.forEach(date => {
                        let dateSum = finalData.reduce((sum, row) => sum + (parseFloat(row[date]) || 0), 0);
                        totalRow[date] = dateSum === 0 ? '' : dateSum.toFixed(2);
                    });
                    finalData.push(totalRow);

                    // ==========================================
                    // 7. UI SUMMARY LABELS UPDATES
                    // ==========================================
                    const updateText = (id, val) => { if (document.getElementById(id)) document.getElementById(id).innerText = val; };

                    let dynamicTotalPercentage = (parseFloat(perOnTrack) + parseFloat(perOffTrack) + parseFloat(perOthers)).toFixed(2);
                    if (isNaN(dynamicTotalPercentage)) {
                        dynamicTotalPercentage = "0.00";
                    }

                    // Update Admin Summary
                    updateText("totalHours", totalManHoursForGangs.toFixed(2));
                    updateText("totalOnTrackWorks", totalOnTrackWorks.toFixed(2));
                    updateText("perOnTrack", perOnTrack);
                    updateText("totalOffTrackWorks", offTrackWorksTotal.toFixed(2));
                    updateText("perOffTrack", perOffTrack);
                    updateText("totalSpecificCategories", totalOthers.toFixed(2));
                    updateText("perOthers", perOthers);
                    updateText("veryLastTotal", dynamicTotalPercentage);

                    // Update Engineer Summary
                    updateText("totalHoursEng", totalManHoursForGangs.toFixed(2));
                    updateText("totalOnTrackWorksEng", totalOnTrackWorks.toFixed(2));
                    updateText("perOnTrackEng", perOnTrack);
                    updateText("totalOffTrackWorksEng", offTrackWorksTotal.toFixed(2));
                    updateText("perOffTrackEng", perOffTrack);
                    updateText("totalSpecificCategoriesEng", totalOthers.toFixed(2));
                    updateText("perOthersEng", perOthers);
                    updateText("veryLastTotalEng", dynamicTotalPercentage);

                    // Update CI Summary
                    updateText("totalHoursCI", totalManHoursForGangs.toFixed(2));
                    updateText("totalOnTrackWorksCI", totalOnTrackWorks.toFixed(2));
                    updateText("perOnTrackCI", perOnTrack);
                    updateText("totalOffTrackWorksCI", offTrackWorksTotal.toFixed(2));
                    updateText("perOffTrackCI", perOffTrack);
                    updateText("totalSpecificCategoriesCI", totalOthers.toFixed(2));
                    updateText("perOthersCI", perOthers);
                    updateText("veryLastTotalCI", dynamicTotalPercentage);
                    updateText("htmlPreparedByPWICI", updatedByPerson);

                    // Update Normal Summary
                    updateText("totalHoursNormal", totalManHoursForGangs.toFixed(2));
                    updateText("totalOnTrackWorksNormal", totalOnTrackWorks.toFixed(2));
                    updateText("perOnTrackNormal", perOnTrack);
                    updateText("totalOffTrackWorksNormal", offTrackWorksTotal.toFixed(2));
                    updateText("perOffTrackNormal", perOffTrack);
                    updateText("totalSpecificCategoriesNormal", totalOthers.toFixed(2));
                    updateText("perOthersNormal", perOthers);
                    updateText("veryLastTotalNormal", dynamicTotalPercentage);
                    updateText("htmlPreparedByPWINormal", updatedByPerson);

                    // ==========================================
                    // 8. DATATABLE INITIALIZATION (CORRECT COLUMN ORDER)
                    // ==========================================
                    let columns = [
                        { data: "work_cat_id", title: "NO", className: "text-center align-middle" },
                        { data: "work_cat_name", title: "CATEGORY", className: "text-center align-middle" },
                        { data: "work_name", title: "WORK DESCRIPTION", className: "align-middle" }
                    ];

                    // 1. Add the 7 date columns
                    sortedDates.forEach(date => {
                        columns.push({
                            data: date,
                            title: date,
                            className: "text-center align-middle",
                            render: d => (d == 0 || d === "0.00" || d === "" || d == null) ? "" : d
                        });
                    });

                    // 3. GRAND TOTAL Column (Last Column)
                    columns.push({
                        data: "TotalTime",
                        title: "GRAND TOTAL",
                        className: "text-center align-middle",
                        render: d => (d == 0 || d === "0.00" || d === "" || d == null) ? "" : d
                    });

                    // 2. DAILY ADDITIONAL Column (Before Grand Total)
                    columns.push({
                        data: "daily_additional",
                        title: "REMARKS",
                        className: "text-center align-middle",
                        defaultContent: "",
                        render: function (data) {
                            if (!data || data == 0) return "";
                            return data;
                        }
                    });

                    function appendBottomSummaryRows(customData) {
                        customData.body.push(new Array(customData.header.length).fill(""));

                        let summaryHeader = new Array(customData.header.length).fill("");
                        summaryHeader[0] = "SUMMARY CALCULATIONS";
                        customData.body.push(summaryHeader);

                        let labelRow = new Array(customData.header.length).fill("");
                        labelRow[0] = "Description";
                        labelRow[1] = "Value";
                        labelRow[2] = "Percentage";
                        customData.body.push(labelRow);

                        var makeSummaryRow = function (desc, val, per) {
                            let r = new Array(customData.header.length).fill("");
                            r[0] = desc;
                            r[1] = val;
                            r[2] = per;
                            return r;
                        };

                        customData.body.push(makeSummaryRow("Total Man-Hours for the Gangs", totalManHoursForGangs.toFixed(2) + " Mhrs", "-"));
                        customData.body.push(makeSummaryRow("On Track Works", totalOnTrackWorks.toFixed(2) + " Mhrs", perOnTrack + " % Mhrs"));
                        customData.body.push(makeSummaryRow("Off Track Works", offTrackWorksTotal.toFixed(2) + " Mhrs", perOffTrack + " % Mhrs"));
                        customData.body.push(makeSummaryRow("Others", totalOthers.toFixed(2) + " Mhrs", perOthers + " % Mhrs"));
                        customData.body.push(makeSummaryRow("Total", "-", dynamicTotalPercentage + " %"));
                        customData.body.push(makeSummaryRow("Validated By PWI On", validatorName, validatedAtDate || "-"));
                        customData.body.push(makeSummaryRow("Verified By JW/KMUJ On", verifierName, verifiedAtDate || "-"));
                    }

                    $('#tableRep, #tableRepNormal, #tableRepEng, #tableRepCI').DataTable({
                        ordering: false,
                        paging: false,
                        dom: 'Bfrtip',
                        responsive: true,
                        data: finalData,
                        columns: columns,
                        buttons: [
                            {
                                extend: 'excel',
                                title: '',
                                messageTop: null,
                                createEmptyCells: true,
                                exportOptions: {
                                    columns: ':visible'
                                },
                                customizeData: function (customData) {
                                    window.excelMergeRanges = [];
                                    let rowOffset = 6; // Data starts at row 6 in Excel

                                    // --- 1. MERGE 'NO' COLUMN (Col A) & 'CATEGORY' COLUMN (Col B) ---
                                    let startRowNo = 0;
                                    let lastNoValue = "";
                                    let startRowCat = 0;
                                    let lastCatValue = "";

                                    for (let i = 0; i < customData.body.length; i++) {
                                        let currentNo = customData.body[i][0];
                                        let currentCat = customData.body[i][1];

                                        // Merge NO Column
                                        if (currentNo !== lastNoValue) {
                                            if (i > startRowNo) {
                                                let fromRow = startRowNo + rowOffset;
                                                let toRow = (i - 1) + rowOffset;
                                                if (fromRow < toRow) {
                                                    window.excelMergeRanges.push(`A${fromRow}:A${toRow}`);
                                                }
                                            }
                                            startRowNo = i;
                                            lastNoValue = currentNo;
                                        } else {
                                            customData.body[i][0] = ""; // Clear duplicate text
                                        }

                                        // Merge CATEGORY Column
                                        if (currentCat !== lastCatValue) {
                                            if (i > startRowCat) {
                                                let fromRow = startRowCat + rowOffset;
                                                let toRow = (i - 1) + rowOffset;
                                                if (fromRow < toRow) {
                                                    window.excelMergeRanges.push(`B${fromRow}:B${toRow}`);
                                                }
                                            }
                                            startRowCat = i;
                                            lastCatValue = currentCat;
                                        } else {
                                            customData.body[i][1] = ""; // Clear duplicate text
                                        }
                                    }

                                    // Finalize merging for remaining rows
                                    if (customData.body.length > startRowNo) {
                                        let fromRow = startRowNo + rowOffset;
                                        let toRow = (customData.body.length - 1) + rowOffset;
                                        if (fromRow < toRow) window.excelMergeRanges.push(`A${fromRow}:A${toRow}`);
                                    }
                                    if (customData.body.length > startRowCat) {
                                        let fromRow = startRowCat + rowOffset;
                                        let toRow = (customData.body.length - 1) + rowOffset;
                                        if (fromRow < toRow) window.excelMergeRanges.push(`B${fromRow}:B${toRow}`);
                                    }

                                    // --- 2. APPEND & SHIFT SUMMARY ROWS ---
                                    appendBottomSummaryRows(customData);

                                    let inSummary = false;
                                    for (let i = 0; i < customData.body.length; i++) {
                                        let row = customData.body[i];
                                        let firstCell = (row[0] || "").toString();

                                        if (firstCell.includes("SUMMARY CALCULATIONS")) {
                                            inSummary = true;
                                        }

                                        if (inSummary) {
                                            let val = row[1] || row[2] || "";
                                            let pct = (row[1] !== val && row[1]) || (row[2] !== val && row[2]) || row[3] || "";

                                            while (row.length < 4) {
                                                row.push("");
                                            }

                                            row[1] = "";   // Clear Col B for merged A:B description
                                            row[2] = val;  // Col C (Value)
                                            row[3] = pct;  // Col D (Percentage)
                                        }
                                    }
                                },
                                customize: function (xlsx) {
                                    let sheet = xlsx.xl.worksheets['sheet1.xml'];
                                    let styles = xlsx.xl['styles.xml'];

                                    // --- 1. HELPER FUNCTION TO EXTRACT DD ONLY FOR TABLE HEADERS ---
                                    let getDD = function (dateStr) {
                                        if (!dateStr) return '';
                                        let str = dateStr.toString().trim();

                                        let m1 = str.match(/^(\d{2})[\/\-]\d{2}[\/\-]\d{4}$/);
                                        if (m1) return m1[1];

                                        let m2 = str.match(/^\d{4}[\/\-]\d{2}[\/\-](\d{2})$/);
                                        if (m2) return m2[1];

                                        return str;
                                    };

                                    // --- 2. CREATE CUSTOM ALIGNMENT STYLES ---
                                    let cellXfs = styles.getElementsByTagName('cellXfs')[0];
                                    let xfs = cellXfs.getElementsByTagName('xf');

                                    // Style A: Center-Horizontal + Center-Vertical
                                    let xfCenter = styles.createElement('xf');
                                    xfCenter.setAttribute('numFmtId', '0');
                                    xfCenter.setAttribute('fontId', '0');
                                    xfCenter.setAttribute('fillId', '0');
                                    xfCenter.setAttribute('borderId', '1');
                                    xfCenter.setAttribute('xfId', '0');
                                    xfCenter.setAttribute('applyAlignment', '1');

                                    let alignCenter = styles.createElement('alignment');
                                    alignCenter.setAttribute('horizontal', 'center');
                                    alignCenter.setAttribute('vertical', 'center');
                                    xfCenter.appendChild(alignCenter);
                                    cellXfs.appendChild(xfCenter);
                                    let centerMiddleStyleIndex = xfs.length - 1;

                                    // Style B: Left-Horizontal + Center-Vertical (No Wrap)
                                    let xfLeft = styles.createElement('xf');
                                    xfLeft.setAttribute('numFmtId', '0');
                                    xfLeft.setAttribute('fontId', '0');
                                    xfLeft.setAttribute('fillId', '0');
                                    xfLeft.setAttribute('borderId', '1');
                                    xfLeft.setAttribute('xfId', '0');
                                    xfLeft.setAttribute('applyAlignment', '1');

                                    let alignLeft = styles.createElement('alignment');
                                    alignLeft.setAttribute('horizontal', 'left');
                                    alignLeft.setAttribute('vertical', 'center');
                                    xfLeft.appendChild(alignLeft);
                                    cellXfs.appendChild(xfLeft);
                                    let leftMiddleStyleIndex = xfs.length - 1;

                                    // Style C: Left-Horizontal + Center-Vertical + WRAP TEXT
                                    let xfLeftWrap = styles.createElement('xf');
                                    xfLeftWrap.setAttribute('numFmtId', '0');
                                    xfLeftWrap.setAttribute('fontId', '0');
                                    xfLeftWrap.setAttribute('fillId', '0');
                                    xfLeftWrap.setAttribute('borderId', '1');
                                    xfLeftWrap.setAttribute('xfId', '0');
                                    xfLeftWrap.setAttribute('applyAlignment', '1');

                                    let alignLeftWrap = styles.createElement('alignment');
                                    alignLeftWrap.setAttribute('horizontal', 'left');
                                    alignLeftWrap.setAttribute('vertical', 'center');
                                    alignLeftWrap.setAttribute('wrapText', '1');
                                    xfLeftWrap.appendChild(alignLeftWrap);
                                    cellXfs.appendChild(xfLeftWrap);
                                    let leftMiddleWrapStyleIndex = xfs.length - 1;

                                    // Update cellXfs count attribute (Required by Excel to recognize newly added styles)
                                    cellXfs.setAttribute('count', xfs.length);

                                    // --- 3. TOP HEADER ROWS ---
                                    let row1 = `<row r="1"><c t="inline"><is><t>KTM BERHAD - WEEKLY PROGRESS - ${sdate} - ${edate}</t></is></c></row>`;
                                    let row2 = `<row r="2"><c t="inline"><is><t>KMUJ:</t></is></c><c t="inline" r="B2"><is><t>${kmuj}</t></is></c></row>`;
                                    let row3 = `<row r="3"><c t="inline"><is><t>Section:</t></is></c><c t="inline" r="B3"><is><t>${section}</t></is></c></row>`;
                                    let row4 = `<row r="4"></row>`;

                                    let sheetData = sheet.getElementsByTagName('sheetData')[0];
                                    let rows = sheetData.getElementsByTagName('row');

                                    let isSummarySection = false;

                                    if (!window.excelMergeRanges) window.excelMergeRanges = [];

                                    window.excelMergeRanges.push('A1:E1');
                                    window.excelMergeRanges.push('B2:E2');
                                    window.excelMergeRanges.push('B3:E3');

                                    // --- 4. PROCESS ROWS ---
                                    for (let i = 0; i < rows.length; i++) {
                                        let oldRowIndex = parseInt(rows[i].getAttribute('r'));
                                        let newRowIndex = oldRowIndex + 4;
                                        rows[i].setAttribute('r', newRowIndex);

                                        let cells = rows[i].getElementsByTagName('c');
                                        let rowText = (rows[i].textContent || "").trim();

                                        if (rowText.includes("SUMMARY CALCULATIONS")) {
                                            isSummarySection = true;
                                        }

                                        if (isSummarySection && rowText.length > 0) {
                                            window.excelMergeRanges.push(`A${newRowIndex}:B${newRowIndex}`);
                                        }

                                        let isEmptyRow = rowText === "";

                                        for (let j = 0; j < cells.length; j++) {
                                            let cellRef = cells[j].getAttribute('r');
                                            let nextCellRef = cellRef.replace(/[0-9]+$/, newRowIndex);
                                            cells[j].setAttribute('r', nextCellRef);

                                            // Get column letter from cellRef (e.g., "L6" -> "L")
                                            let colLetter = cellRef.replace(/[0-9]/g, '');

                                            // TRUNCATE TABLE HEADER DATES (Row 5) TO DD
                                            if (newRowIndex === 5) {
                                                let textNode = cells[j].getElementsByTagName('t')[0];
                                                if (textNode) {
                                                    textNode.textContent = getDD(textNode.textContent);
                                                }
                                            }

                                            if (!isSummarySection && !isEmptyRow) {
                                                // MATCH COLUMN BY LETTER "L" OR INDEX 11 (REMARKS COLUMN)
                                                if (newRowIndex > 5 && (colLetter === 'L' || j === 11)) {
                                                    cells[j].setAttribute('s', leftMiddleWrapStyleIndex);
                                                } else if (newRowIndex > 5 && (colLetter === 'C' || j === 2)) {
                                                    // Work Description (Col C) -> Left Aligned
                                                    cells[j].setAttribute('s', leftMiddleStyleIndex);
                                                } else {
                                                    // All other cells -> Center Aligned
                                                    cells[j].setAttribute('s', centerMiddleStyleIndex);
                                                }
                                            } else {
                                                cells[j].removeAttribute('s');
                                            }
                                        }
                                    }

                                    sheetData.innerHTML = row1 + row2 + row3 + row4 + sheetData.innerHTML;

                                    // --- 5. INJECT ALL MERGE RANGES ---
                                    if (window.excelMergeRanges && window.excelMergeRanges.length > 0) {
                                        let mergeCellsTag = sheet.getElementsByTagName('mergeCells')[0];

                                        if (!mergeCellsTag) {
                                            mergeCellsTag = sheet.createElement('mergeCells');
                                            sheet.getElementsByTagName('worksheet')[0].appendChild(mergeCellsTag);
                                        }

                                        window.excelMergeRanges.forEach(range => {
                                            let mergeCell = sheet.createElement('mergeCell');
                                            mergeCell.setAttribute('ref', range);
                                            mergeCellsTag.appendChild(mergeCell);
                                        });

                                        let currentCount = parseInt(mergeCellsTag.getAttribute('count') || 0);
                                        mergeCellsTag.setAttribute('count', currentCount + window.excelMergeRanges.length);
                                    }
                                }
                            }
                        ],

                        // ===================================================
                        // DYNAMICALLY MERGE BOTH "NO" AND "CATEGORY" CELLS
                        // ===================================================
                        drawCallback: function (settings) {
                            var api = this.api();
                            var rows = api.rows({ page: 'current' }).nodes();
                            var lastCategory = null;
                            var rowspan = 1;
                            var targetCatCell = null;
                            var targetNoCell = null;

                            api.column(1, { page: 'current' }).data().each(function (categoryName, i) {
                                var currentRow = $(rows[i]);
                                var currentNoCell = currentRow.find('td').eq(0);  // Column Index 0 = NO
                                var currentCatCell = currentRow.find('td').eq(1); // Column Index 1 = CATEGORY

                                // Ignore the bottom TOTAL row or empty categories
                                if (!categoryName || categoryName === 'TOTAL') {
                                    lastCategory = null;
                                    return;
                                }

                                if (lastCategory === categoryName) {
                                    // Consecutive matching category found: increment rowspan & hide repeated cells
                                    rowspan++;
                                    targetNoCell.attr('rowspan', rowspan);
                                    targetCatCell.attr('rowspan', rowspan);

                                    currentNoCell.hide();
                                    currentCatCell.hide();
                                } else {
                                    // New category encounter: reset counters and store target cells
                                    lastCategory = categoryName;
                                    rowspan = 1;
                                    targetNoCell = currentNoCell;
                                    targetCatCell = currentCatCell;
                                }
                            });
                        },

                        rowCallback: function (row, data, index) {
                            const catCell = $('td', row).eq(1);
                            const noCell = $('td', row).eq(0);
                            if (data.work_cat_name === 'TOTAL') {
                                $(row).css('font-weight', 'bold').addClass('table-info');
                                catCell.attr('colspan', 2).css('text-align', 'center').show();
                                noCell.hide();
                            }
                        }
                    });
                },
                error: function (xhr) { console.error("Error fetching data:", xhr); }
            });

            // Helper: Resets Summary labels back to 0 when empty
            function resetSummaryLabels(updatedByPerson) {
                const updateText = (id, val) => { if (document.getElementById(id)) document.getElementById(id).innerText = val; };
                const suffixes = ["", "Eng", "CI", "Normal"];
                suffixes.forEach(sfx => {
                    updateText("totalHours" + sfx, "0.00");
                    updateText("totalOnTrackWorks" + sfx, "0.00");
                    updateText("perOnTrack" + sfx, "0.00");
                    updateText("totalOffTrackWorks" + sfx, "0.00");
                    updateText("perOffTrack" + sfx, "0.00");
                    updateText("totalSpecificCategories" + sfx, "0.00");
                    updateText("perOthers" + sfx, "0.00");
                    updateText("veryLastTotal" + sfx, "0.00");
                });
                updateText("htmlPreparedByPWICI", updatedByPerson);
                updateText("htmlPreparedByPWINormal", updatedByPerson);
            }

            // Helper: Renders clean tables showing "No data available in table"
            function initializeEmptyTables(datesArray) {
                let activeDates = datesArray || [];
                let columns = [{ title: "NO" }, { title: "CATEGORY" }, { title: "WORK DESCRIPTION" }];
                activeDates.forEach(date => columns.push({ title: date }));
                columns.push({ title: "GRAND TOTAL" });

                $('#tableRep, #tableRepNormal, #tableRepEng, #tableRepCI').DataTable({
                    ordering: false, paging: false, dom: 'Bfrtip', responsive: true,
                    data: [],
                    columns: columns,
                    buttons: ['csv', 'excel']
                });
            }
        }

    </script>
